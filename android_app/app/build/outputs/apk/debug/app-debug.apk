- name: Build V7 Debug APK
  run: |
    gradle -p android_app :app:assembleDebug

- name: Verify APK
  run: |
    test -f android_app/app/build/outputs/apk/debug/app-debug.apk
    ls -lh android_app/app/build/outputs/apk/debug/app-debug.apk

- name: Upload APK
  uses: actions/upload-artifact@v4
  with:
    name: NIFTY-Option-AI-V7-APK
    path: android_app/app/build/outputs/apk/debug/app-debug.apk
    if-no-files-found: error
