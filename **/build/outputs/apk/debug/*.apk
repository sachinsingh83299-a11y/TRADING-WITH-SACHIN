name: Build NIFTY Option AI APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    name: Build Android APK
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Locate Android project
        shell: bash
        run: |
          if [ -f "android_app/settings.gradle" ]; then
            ANDROID_DIR="android_app"
          elif [ -f "android_app/settings.gradle.kts" ]; then
            ANDROID_DIR="android_app"
          else
            FOUND=$(find . -type f \
              \( -name "settings.gradle" -o -name "settings.gradle.kts" \) \
              -not -path "./.git/*" | head -n 1)

            if [ -n "$FOUND" ]; then
              ANDROID_DIR=$(dirname "$FOUND")
            else
              echo "ERROR: Android project not found"
              find . -maxdepth 5 -type f | sort
              exit 1
            fi
          fi

          echo "Android project: $ANDROID_DIR"
          echo "ANDROID_DIR=$ANDROID_DIR" >> "$GITHUB_ENV"

      - name: Check Android project
        run: |
          ls -la "$ANDROID_DIR"
          echo "Checking Gradle files..."
          find "$ANDROID_DIR" -maxdepth 3 -type f \
            \( -name "*.gradle" -o -name "*.gradle.kts" \) -print

      - name: Build APK
        run: |
          gradle \
            -p "$ANDROID_DIR" \
            assembleDebug \
            --stacktrace \
            --no-daemon

      - name: Find APK
        run: |
          echo "Generated APK files:"
          find "$ANDROID_DIR" -type f -name "*.apk" -print

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NIFTY-Option-AI-debug
          path: |
            **/build/outputs/apk/debug/*.apk
          if-no-files-found: error
